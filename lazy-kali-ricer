#!/usr/bin/env python3
"""lazy-kali-ricer: rice Hyprland from a GUI, and keep your apps, tools and browser setup in a kit.

  lazy-kali-ricer                 Open the GUI.
  lazy-kali-ricer apply           Write the configs from the saved settings (no GUI).
  lazy-kali-ricer banner          Show the terminal banner now, as set in the Terminal tab.
  lazy-kali-ricer burp            Burp Suite, FoxyProxy and Burp's certificate in your browsers, on the saved proxy port.
  lazy-kali-ricer burp 8081       The same, on that port (1024-65535); the port is remembered.
  lazy-kali-ricer update          Get the newest version from GitHub and apply it.
  lazy-kali-ricer revert          Go back to the version in use before the last update.
  lazy-kali-ricer revert v12      Roll back (or forward) to that version: a number or id from `versions`.
  lazy-kali-ricer version         Show the installed version.
  lazy-kali-ricer versions        List the versions: which one is installed, which are newer, where to go back to.
  lazy-kali-ricer debug on        Mirror the Hyprland log to ~/.cache/lazy-kali-ricer/hyprland.log.
  lazy-kali-ricer debug off       Stop mirroring.
  lazy-kali-ricer debug report    Save a shareable report (versions, settings, config errors, log tail).
  lazy-kali-ricer uninstall       List every change it would undo and ask about each one.

Sync with another of your devices over Tailscale (shortcuts, zsh files, tools, browser extensions, files):
  lazy-kali-ricer sync devices           List your other devices.
  lazy-kali-ricer sync compare <device>  Show what each device has and the other lacks.
  lazy-kali-ricer sync from <device>     That device is the master: make this one like it.
  lazy-kali-ricer sync to <device>       This device is the master: make that one like it.
  lazy-kali-ricer sync merge <device>    Each device gains what only the other has.
  lazy-kali-ricer sync folders <device>  List the folders there you can get files from.
  lazy-kali-ricer sync files <device> [folder ...] [--types pdf,jpg]
                                         Get files from there: new ones are copied, and for each file that
                                         differs you choose to keep yours, take theirs or keep both.
                                         Folders and types are remembered; leave them out to reuse them.
<device> is its Tailscale name, or user@name when your user name differs there.
"""
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from lkr import core  # noqa: E402

args = sys.argv[1:]
if not args:
    from lkr import gui
    gui.main()
elif args == ["apply"]:
    print("\n".join(core.apply(core.load())))
elif args == ["banner"]:
    from lkr import fetch, term
    cfg, problem = term.banner(core.load())
    print("\n" + "\n".join(fetch.lines(cfg, shutil.get_terminal_size().columns)) + "\n")
    if problem:
        print(problem)
elif args[:1] == ["burp"] and len(args) <= 2:
    from lkr import burp
    number = burp.valid_port(args[1]) if len(args) == 2 else burp.port(core.load())
    if not number:
        sys.exit("Not a port Burp can use: %s. Give a number from 1024 to 65535." % args[1])
    burp.set_port(number)
    ok, log = burp.setup(number, burp.browsers())
    print("\n".join(log))
    ok or sys.exit(1)
elif args == ["version"]:
    print(core.version() or "unknown (not installed with git)")
elif args == ["versions"]:
    marks = {"current": "*  installed", "newer": "^  newer", "own": "+  not on GitHub", "older": ""}
    for v in core.versions():
        print("%-22s v%-4d %s  %s  %s" % (marks[v["state"]] or ("<  before last update" if v["previous"] else ""),
                                          v["number"], v["short"], v["date"], v["what"]))
    if not core.version():
        print("unknown (not installed with git)")
elif args in (["update"], ["revert"]) or (len(args) == 2 and args[0] == "revert"):
    say = lambda text, part=None: print(text)
    if len(args) == 2:
        wanted = core.find_version(args[1])
        changed, message = core.switch_to(wanted["id"], say) if wanted else (False, "No version %s. See: lazy-kali-ricer versions" % args[1])
    else:
        changed, message = core.update(say) if args == ["update"] else core.revert(say)
    print(message)
    if changed:
        print(core.reapply())
elif args in (["debug", "on"], ["debug", "off"]):
    on = core.set_debug(args[1] == "on")["debug"]
    print("Debug logging on: %s" % core.DEBUG_LOG if on else "Debug logging off.")
elif args == ["debug", "report"]:
    print("Report saved: %s\nRead it before you share it." % core.debug_report())
elif args == ["uninstall"]:
    items = core.uninstall_items()
    chosen = []
    for item in items:
        answer = input("%s? [%s] " % (item["label"], "Y/n" if item["on"] else "y/N")).strip().lower()
        if answer in ("y", "yes") or (not answer and item["on"]):
            chosen.append(item)
    if not items:
        print("Nothing to uninstall.")
    elif chosen and input("Carry out %d of %d steps? [y/N] " % (len(chosen), len(items))).strip().lower() in ("y", "yes"):
        print("\n".join(core.uninstall(chosen)))
    else:
        print("Nothing changed.")
elif args[:1] == ["sync"]:
    from lkr import sync
    sync.command(args[1:]) or sys.exit(__doc__)
else:
    sys.exit(__doc__)
